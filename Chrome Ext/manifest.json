{
  "manifest_version": 3,
  "name": "DSR Assistant",
  "version": "1.0.0",
  "description": "Premium Jira-powered Daily Status Report dashboard with analytics, charts, and export.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DSR Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.atlassian.net/"],
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "dashboard.css", "dashboard.js", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
