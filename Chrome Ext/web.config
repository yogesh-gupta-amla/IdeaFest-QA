<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Azure App Service (Windows) routing config.
  Routes ALL requests through the Node.js server (server.mjs via iisnode)
  so that /jira-proxy/* is handled by Express, not IIS static-file serving.

  Without this file IIS intercepts /jira-proxy/* and returns 406 "Client
  browser does not accept the MIME type" because its HTML error page does
  not match the client's Accept: application/json header.
-->
<configuration>
  <system.webServer>

    <!-- Route everything to server.mjs via the iisnode handler -->
    <handlers>
      <add name="iisnode" path="server.mjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Do not intercept Node inspector debug URLs -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server\.mjs\/debug[\/]?" />
        </rule>

        <!-- Route every non-file / non-directory request to Node (Express) -->
        <rule name="AllToNode" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.mjs" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let Node control the response — do not replace error pages -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Allow iisnode to access its own file -->
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <iisnode
      node_env="production"
      watchedFiles="web.config;*.mjs"
      loggingEnabled="true"
      logDirectory="iisnode"
    />

  </system.webServer>
</configuration>
