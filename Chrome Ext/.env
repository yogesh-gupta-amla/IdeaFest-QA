# APT API base URL
VITE_APT_BASE_URL=https://apt.amla.io

# Same-origin proxy prefix for APT API (avoids browser CORS)
VITE_APT_PROXY_PREFIX=/apt-proxy

# Default Jira instance URL (used when none is provided via URL params or storage)
VITE_DEFAULT_JIRA_URL=https://amla.atlassian.net

# Same-origin proxy path used by the frontend
VITE_JIRA_PROXY_PREFIX=/jira-proxy

# Admin account credentials — when both are set every user is automatically
# signed in with this account and the login form is hidden entirely.
# The token is the Atlassian API token (NOT the account password).
VITE_ADMIN_EMAIL=rajdhan.bhagat@amla.io
VITE_ADMIN_TOKEN=ATATT3xFfGF0BiN0gMO2ykckRjXNGpeTZFD_UBiY9FFDfbNewdDr0Y33X3gHgG63MbTPUTA42Y8Tbc900ox7KEuE3Y0lG1cKRzlKUkxXWMcqLHWYfPkkzlRTj8P-9xfOljkrTDYpI4JA5QmTcq_u0c2prPIpCNZvnI1T3TcU7T4UwhpzDymBZ3o=A6C3AEA2

# Comma-separated origins allowed to embed this app in an iframe.
# Both email (URL param) and referrer must match for production access.
VITE_ALLOWED_REFERRER_ORIGINS=https://insightsai.amla.io,https://stage-insightsai.amla.io
