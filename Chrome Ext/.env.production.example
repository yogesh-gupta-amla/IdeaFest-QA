# Same-origin proxy path used by the frontend in deployed environments.
# Keep /jira-proxy unless your backend exposes another route.
VITE_JIRA_PROXY_PREFIX=/jira-proxy

# Keep query fallback disabled by default to avoid strict host/WAF 406 rules.
# Set to true only if your host strips x-jira-base-url and you need query fallback.
# VITE_JIRA_PROXY_QUERY_FALLBACK=false

# Optional backend runtime variable for server.mjs
# JIRA_PROXY_PREFIX=/jira-proxy
