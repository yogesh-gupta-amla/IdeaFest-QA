<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.mjs" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.mjs" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <!--
      nodeProcessCommandLine: explicit path to node.exe. iisnode runs under
      the app pool identity, whose PATH often does not include the Node
      install dir, which causes "iisnode is unable to start the node.exe
      process". Adjust the path below if Node is installed elsewhere on the
      IIS server (verify with `where node` from an Administrator cmd).
    -->
    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
      watchedFiles="web.config;*.mjs;*.js"
      node_env="production" />
  </system.webServer>
</configuration>
